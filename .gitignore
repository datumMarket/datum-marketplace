node_modules/
.env
*.log
.DS_Store

# Credentials — never, under any circumstance.
# NOTE: the on-disk folder is SECRETS/ (uppercase). The old entry here was
# lowercase `secrets/`, which is invisible on macOS but would NOT match on a
# case-sensitive filesystem (Linux CI, a clone, a container). Both are listed.
SECRETS/
secrets/
.npmrc

# Deploy tooling: contains the server IP and storage wiring.
infra/
scripts/

# Planning documents — thesis, spec, roadmap, runbook, deployment notes.
# Everything in docs/ is internal EXCEPT the files explicitly re-included below.
# Ignore by DIRECTORY, not by extension. A stray .txt/.json/.csv dropped in here must
# not be swept into the public repo by a `git add -A` — that is exactly how
# x-article-paste.txt sat exposed until 2026-10-01.
# Re-included one file at a time, and only after JB has read and approved that
# specific document. THESIS / VISION / PAPER-OUTLINE / TOKEN-ARGUMENT are NOT
# re-included and are not approved for release.
docs/*
!docs/openapi.yaml
!docs/TOKENOMICS.md
!docs/WHITEPAPER.md

# Data, build output, coverage.
data/
server/data/
data-testnet/
data-exp/
data-rig/
artifacts/
cache/
coverage/

# Wallet material.
wallets-*.txt

# Package artifacts from local npm pack testing.
*.tgz

# Brand assets — held until publishing is explicitly approved.
assets/

# derived draft artifacts under docs/ — never published (only openapi.yaml is tracked)
docs/*.pdf
docs/*.html
